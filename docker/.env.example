# ────────────────────────────────────────────────────────────────────────────
# BudgetBee Environment Configuration
# ────────────────────────────────────────────────────────────────────────────
# SECURITY: Copy this to `.env` and CHANGE ALL DEFAULT VALUES before deploying!
# Never commit real .env to git. Use a secret manager in production.

# ── App ─────────────────────────────────────────────────────────────────────
APP_PORT=80
APP_PORT_SSL=443
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-domain.com

# Generate with: php artisan key:generate
APP_KEY=base64:GENERATE_WITH_php_artisan_key_generate

# ── Database ────────────────────────────────────────────────────────────────
DB_HOST=db
DB_DATABASE=budgetbee
DB_USERNAME=budgetbee_user

# ⚠️  CHANGE THESE — minimum 32 random characters
DB_PASSWORD=CHANGE_ME_use_at_least_32_random_chars_here_abc123XYZ!@#
DB_ROOT_PASSWORD=CHANGE_ME_root_separate_32_char_random_password_xyz!@#

# Legacy names — same values as above
MYSQL_ROOT_PASSWORD=${DB_ROOT_PASSWORD}
MYSQL_DATABASE=${DB_DATABASE}
MYSQL_USER=${DB_USERNAME}
MYSQL_PASSWORD=${DB_PASSWORD}

# ── Security ────────────────────────────────────────────────────────────────
HASH_DRIVER=argon2id
ARGON_MEMORY=65536
ARGON_THREADS=4
ARGON_TIME=4

# CORS — comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# Session security
SESSION_SECURE_COOKIE=true
SESSION_LIFETIME=120

# ── Mail (for password reset, 2FA codes) ────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.your-provider.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@your-domain.com
MAIL_FROM_NAME="BudgetBee"

# ── Pepper (extra password layer — store in VAULT, not .env in prod) ───────
PASSWORD_PEPPER=CHANGE_ME_64_random_bytes_keep_secret_outside_git
